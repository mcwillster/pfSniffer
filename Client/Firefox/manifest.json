{
  "manifest_version": 3,
  "name": "pfSniffer",
  "version": "1.7",
  "description": "Logs the pfSense PHPSESSID cookie upon login.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pfsense_logger@bithavenbuffalo.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://192.168.10.169/*",
    "*://10.1.1.1/*",
    "*://10.2.1.1/*",
    "*://10.3.1.1/*",
    "*://10.4.1.1/*",
    "*://10.5.1.1/*",
    "*://10.6.1.1/*",
    "*://10.7.1.1/*",
    "*://10.8.1.1/*",
    "*://10.9.1.1/*",
    "*://10.10.1.1/*",
    "*://10.11.1.1/*",
    "*://10.12.1.1/*",
    "*://10.13.1.1/*",
    "*://10.14.1.1/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}