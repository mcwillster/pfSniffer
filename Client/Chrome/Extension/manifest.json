{
  "manifest_version": 3,
  "name": "pfSense Session Logger",
  "version": "1.4",
  "description": "Logs the pfSense PHPSESSID cookie upon login.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://192.168.1.9/*",
    "*://192.168.1.254/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}